<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.ensera.taisce</groupId>
  <artifactId>taisce-java</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Taisce for Java</name>
  <description>The client and the LangChain4j and Spring AI adapters for a Taisce memory deployment.</description>
  <licenses><license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>
  <url>https://github.com/ensera-ai/taisce-java</url>
  <scm>
    <connection>scm:git:https://github.com/ensera-ai/taisce-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ensera-ai/taisce-java.git</developerConnection>
    <url>https://github.com/ensera-ai/taisce-java</url>
  </scm>
  <developers>
    <developer><name>The Taisce Authors</name><url>https://github.com/ensera-ai/taisce-java</url></developer>
  </developers>
  <modules>
    <module>taisce-client</module>
    <module>taisce-langchain4j</module>
    <module>taisce-spring-ai</module>
  </modules>
  <properties>
    <revision>0.2.0</revision>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The framework versions every module compiles against, in one place. -->
    <langchain4j.version>1.23.0</langchain4j.version>
    <spring-ai.version>2.0.2</spring-ai.version>
    <jackson.version>2.23.0</jackson.version>
    <!-- Spring AI 2 reads JSON with Jackson 3 (tools.jackson), a separate line with its own group and BOM. -->
    <jackson3.version>3.3.0</jackson3.version>
    <junit.version>6.1.3</junit.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <!-- The BOM, not databind alone: a framework brings its own jackson-core, and databind and core
           on different versions is a classpath nobody tested. Importing the BOM pins every Jackson
           artifact to one line, in every module, and `mvn dependency:tree` shows the proof. -->
      <dependency><groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId><version>${jackson.version}</version><type>pom</type><scope>import</scope></dependency>
      <!-- After the 2.x BOM on purpose: the 3.x BOM also manages jackson-annotations (which stayed 2.x),
           and the first import to name an artifact wins, so annotations follow the line above. -->
      <dependency><groupId>tools.jackson</groupId><artifactId>jackson-bom</artifactId><version>${jackson3.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j</artifactId><version>${langchain4j.version}</version></dependency>
      <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-client-chat</artifactId><version>${spring-ai.version}</version></dependency>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.1</version></plugin>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>flatten-maven-plugin</artifactId><version>1.9.0</version>
        <configuration><updatePomFile>true</updatePomFile><flattenMode>ossrh</flattenMode></configuration>
        <executions>
          <execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution>
          <execution><id>flatten-clean</id><phase>clean</phase><goals><goal>clean</goal></goals></execution>
        </executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version>
        <configuration><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration></plugin>
    </plugins>
  </build>
  <profiles>
    <!-- The tests that need a deployment. Not part of `mvn verify`: they read TAISCE_API, TAISCE_TOKEN
         and TAISCE_READER_TOKEN and FAIL, never skip, when one is missing, because a skipped test is a
         green run that asserted nothing. conformance.yml runs them; run them yourself with
         `mvn -Plive verify -pl taisce-client`. Failsafe is declared only here, so the *LiveIT classes
         are compiled everywhere and executed only when this profile is chosen. -->
    <profile>
      <id>live</id>
      <build>
        <plugins>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.6.1</version>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin>
        </plugins>
      </build>
    </profile>
    <!-- The release profile builds every file Central requires and nothing that signs or uploads.
         Signing and upload happen in release.yml, in a job that runs no Maven: Maven resolves and
         executes plugins at run time, and none of that code should share a process with the signing
         key. A signing or publishing plugin here would put it back beside the key. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version>
            <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.12.0</version>
            <executions><execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution></executions></plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
